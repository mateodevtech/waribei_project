# Variables lues par docker-compose.yml (racine du monorepo).
# Copie ce fichier en ".env" à la racine avant de lancer `docker compose up`.
# Ne concerne QUE l'orchestration Docker — chaque app garde son propre .env
# pour un lancement en local sans Docker (voir apps/backend/.env.example et
# apps/frontend/.env.example).

JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN_SECONDS=86400
VITE_API_URL=http://localhost:3000
